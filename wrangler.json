{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "python-practice",
  "main": "cloudflare/classroom-worker.ts",
  "compatibility_date": "2026-05-15",
  "workers_dev": true,
  "assets": {
    "directory": "./docs",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/classroom-config.json"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "CLASSROOM",
        "class_name": "Classroom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "classroom-v1",
      "new_sqlite_classes": [
        "Classroom"
      ]
    }
  ],
  "vars": {
    "STUDENT_ORIGIN": "https://ivanporras01.github.io",
    "TEACHER_PUBLIC_KEY": "Yw2Tso99zPjIYqk9k1Ymp7BaOucKGOBvo+gLZZtM5n4="
  }
}
